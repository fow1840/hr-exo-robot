<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <!-- ROS2 包名不含 '-' (规范要求); 目录名保留 SolidWorks 原包名风格 + fixed 后缀 -->
  <name>hr_up_7dof_fixed</name>
  <version>1.0.0</version>
  <description>HR-UP-7DOF-3KG-R-B01382 dual 7-DOF arms robot, fixed URDF package (upright, mirrored left arm, self-contained meshes)</description>
  <maintainer email="user@todo.todo">zhouyiwu</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
